# Credenciales y configuración del sistema Bendito Buffet
# Copia este archivo como `.env` y completa los valores reales.
# NUNCA subas el archivo `.env` al repositorio.

# --- Base de datos PostgreSQL (Supabase) ---
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543
DB_NAME=postgres

# --- Flask ---
# Clave secreta para firmar cookies de sesión (generar con: secrets.token_hex(32))
SECRET_KEY=
# production, development o testing
APP_ENV=production
# 1 = modo debug (solo desarrollo), 0 = producción
FLASK_DEBUG=0
# Interfaz de escucha de app.py. Por defecto: 127.0.0.1 con FLASK_DEBUG=1 y 0.0.0.0 sin debug.
# Usa 0.0.0.0 solo si necesitas entrar desde otros equipos de la red.
FLASK_HOST=
# IP o redes CIDR de proxies que pueden enviar X-Forwarded-For, separadas por coma
TRUSTED_PROXY_IPS=

# --- Gmail (envío de reportes) ---
# Usar una CONTRASEÑA DE APLICACIÓN (no la contraseña normal)
# Paso a paso: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_PASSWORD=

# --- API RENIEC (consulta DNI) ---
# Token de https://apisperu.com (se usa SOLO del lado del servidor)
DNI_API_TOKEN=

# --- Mantenimiento ---
# Días que se conservan los registros de actividad_usuario e intentos_login
# antes de que `limpiar_logs.py` los borre
RETENCION_LOGS_DIAS=90
